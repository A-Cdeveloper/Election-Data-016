// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}



model Place {
  id               Int        @id @default(autoincrement())
  number           Int        @unique
  object           String     @db.VarChar(512)
  address          String     @db.VarChar(255)
  registeredVoters Int        @map("registered_voters")
  latitude         Float
  longitude            Float
  incidents            Incident[]
  currentPlaceStatus   CurrentPlaceStatus?
  turnoutRecords       TurnoutRecord[]

  @@map("places")
}

/// Trenutna izlaznost na BM (jedan red po mestu, ažurira se pri unosu)
model CurrentPlaceStatus {
  id         Int      @id @default(autoincrement())
  placeId    Int      @unique @map("place_id")
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  votedCount Int      @map("voted_count")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("current_place_statuses")
}

/// Istorijski unos trenutne izlaznosti na biračkom mestu
model TurnoutRecord {
  id         Int      @id @default(autoincrement())
  placeId    Int      @map("place_id")
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  votedCount Int      @map("voted_count")
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([placeId, recordedAt])

  @@index([placeId, createdAt])
  @@map("turnout_records")
}


model IncidentType {
  code      String     @id @db.VarChar(4)
  name      String     @db.VarChar(512)
  incidents Incident[]

  @@map("incident_types")
}

/// Prijava incidenta na određenom biračkom mestu
model Incident {
  id               Int          @id @default(autoincrement())
  placeId          Int          @map("place_id")
  place            Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  incidentTypeCode String       @map("incident_type_code") @db.VarChar(4)
  incidentType     IncidentType @relation(fields: [incidentTypeCode], references: [code])
  description      String       @db.Text
  reportedAt       DateTime     @map("reported_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([placeId])
  @@index([reportedAt])
  @@map("incidents")
}

/// Admin / posmatrač — bez rola, svi jednaki pristup
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}